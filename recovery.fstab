/system                  ext4     /dev/block/bootdevice/by-name/system      flags=display=system wait
/vendor                  ext4     /dev/block/bootdevice/by-name/vendor      flags=display=vendor wait
/metadata                ext4     /dev/block/bootdevice/by-name/metadata    flags=display=metadata wait
/data                    f2fs     /dev/block/bootdevice/by-name/userdata    flags=display=data wait encryptable=footer length=-16384
/cache                   ext4     /dev/block/bootdevice/by-name/cache       flags=display=cache wait
/oem                     ext4     /dev/block/bootdevice/by-name/oem         flags=display=oem wait
/vendor/firmware_mnt     vfat     /dev/block/bootdevice/by-name/modem       flags=display=firmware_mnt wait
/vendor/dsp              ext4     /dev/block/bootdevice/by-name/dsp         flags=display=dsp wait
/mnt/vendor/persist      ext4     /dev/block/bootdevice/by-name/persist     flags=display=persist wait
/vendor/bt_firmware      vfat     /dev/block/bootdevice/by-name/bluetooth   flags=display=bt_firmware wait
/misc                    emmc     /dev/block/bootdevice/by-name/misc        flags=display=misc wait
/boot                    emmc     /dev/block/bootdevice/by-name/boot        flags=display=boot wait
/recovery                emmc     /dev/block/bootdevice/by-name/recovery    flags=display=recovery wait
/vbmeta                  emmc     /dev/block/bootdevice/by-name/vbmeta      flags=display=vbmeta wait
/dtbo                    emmc     /dev/block/bootdevice/by-name/dtbo        flags=display=dtbo wait
/storage/usbotg          vfat     /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*     flags=display=usbotg wait
/otg                     vfat     /dev/block/sdg1                                           flags=display=otg wait
