# Vendor variant of recovery.fstab — with backup=1 and flashimg=1 flags on all partitions.

/system          ext4    /dev/block/bootdevice/by-name/system       flags=display=system;backup=1;flashimg=1
/vendor          ext4    /dev/block/bootdevice/by-name/vendor       flags=display=vendor;backup=1;flashimg=1
/metadata        ext4    /dev/block/by-name/metadata               flags=display=metadata;backup=1;flashimg=1
/data            f2fs    /dev/block/bootdevice/by-name/userdata     flags=display=userdata;backup=1;flashimg=1
/cache           ext4    /dev/block/bootdevice/by-name/cache        flags=display=cache;backup=1;flashimg=1
/oem             ext4    /dev/block/bootdevice/by-name/oem          flags=display=oem;backup=1;flashimg=1
/storage/sdcard1 vfat    /dev/block/mmcblk1p1                       flags=display=sdcard;backup=1;flashimg=1
/vendor/firmware_mnt vfat /dev/block/bootdevice/by-name/modem       flags=display=modem;backup=1;flashimg=1
/vendor/dsp      ext4    /dev/block/bootdevice/by-name/dsp          flags=display=dsp;backup=1;flashimg=1
/mnt/vendor/persist ext4 /dev/block/bootdevice/by-name/persist      flags=display=persist;backup=1;flashimg=1
/vendor/bt_firmware vfat /dev/block/bootdevice/by-name/bluetooth     flags=display=bluetooth;backup=1;flashimg=1
/misc            emmc    /dev/block/bootdevice/by-name/misc          flags=display=misc;backup=1;flashimg=1
/boot            emmc    /dev/block/bootdevice/by-name/boot          flags=display=boot;backup=1;flashimg=1
/recovery        emmc    /dev/block/bootdevice/by-name/recovery      flags=display=recovery;backup=1;flashimg=1
/vbmeta          emmc    /dev/block/bootdevice/by-name/vbmeta        flags=display=vbmeta;backup=1;flashimg=1
/dtbo            emmc    /dev/block/bootdevice/by-name/dtbo          flags=display=dtbo;backup=1;flashimg=1
/storage/usbotg  vfat    /dev/block/sdg1                             flags=display=usbotg;backup=1;flashimg=1
/otg             vfat    /dev/block/sdg1                             flags=display=otg;backup=1;flashimg=1
/sdcard          vfat    /dev/block/mmcblk1p1                        flags=display=sdcard;backup=1;flashimg=1
