# TWRP recovery fstab for vivo PD1936 (V1936A)
# Based on /vendor/etc/fstab.qcom from device

# system (as system_root for system-as-root devices)
/system_root         ext4    /dev/block/bootdevice/by-name/system                flags=display="System";backup=1;flashimg                                ro,barrier=1,discard

# vendor
/vendor              ext4    /dev/block/bootdevice/by-name/vendor                flags=display="Vendor";backup=1;flashimg                                ro,barrier=1

# metadata (encryption metadata)
/metadata            ext4    /dev/block/bootdevice/by-name/metadata              flags=display="Metadata";backup=1;wipeingui                             noatime,nosuid,nodev,discard

# userdata (FBE with ICE inline encryption)
/data                f2fs    /dev/block/bootdevice/by-name/userdata              flags=display="Data";backup=1;encryptable=footer;fileencryption=ice;wrappedkey;length=-16384;wipeingui;flashimg  noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt

# cache
/cache               ext4    /dev/block/bootdevice/by-name/cache                 flags=display="Cache";backup=1;wipeingui                                noatime,nosuid,nodev,barrier=1

# oem
/oem                 ext4    /dev/block/bootdevice/by-name/oem                   flags=display="OEM";backup=1                                           ro,barrier=1,discard

# vgc (vivo game center - cannot be probed/mounted in recovery)
/vgc                 emmc    /dev/block/bootdevice/by-name/vgc                   flags=display="VGC";backup=1;flashimg

# modem firmware
/vendor/firmware_mnt vfat    /dev/block/bootdevice/by-name/modem                 flags=display="Modem";backup=1;flashimg                                 ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0

# dsp
/vendor/dsp          ext4    /dev/block/bootdevice/by-name/dsp                   flags=display="DSP";backup=1                                           ro,nosuid,nodev,barrier=1

# persist (mounted by init.recovery.qcom.rc for TEE)
/mnt/vendor/persist  ext4    /dev/block/bootdevice/by-name/persist               flags=display="Persist";backup=1;nomanualmount                         noatime,nosuid,nodev,barrier=1

# bluetooth firmware
/vendor/bt_firmware  vfat    /dev/block/bootdevice/by-name/bluetooth             flags=display="Bluetooth";backup=1;flashimg                             ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0

# misc (needed by update_engine to detect boot device)
/misc                emmc    /dev/block/bootdevice/by-name/misc                  flags=display="Misc";backup=1

# boot
/boot                emmc    /dev/block/bootdevice/by-name/boot                  flags=display="Boot";backup=1;flashimg

# recovery
/recovery            emmc    /dev/block/bootdevice/by-name/recovery              flags=display="Recovery";backup=1;flashimg

# vbmeta
/vbmeta              emmc    /dev/block/bootdevice/by-name/vbmeta                flags=display="Vbmeta";backup=1;flashimg

# dtbo
/dtbo                emmc    /dev/block/bootdevice/by-name/dtbo                  flags=display="Dtbo";backup=1;flashimg

# External SD card
/external_sd         vfat    /dev/block/mmcblk1p1                                flags=display="Micro SD";removable;storage;wipeingui                    nosuid,nodev

# USB OTG
/usb_otg             vfat    /dev/block/sdg1                                     flags=display="USB OTG";removable;storage;wipeingui                     nosuid,nodev
